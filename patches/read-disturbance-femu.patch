+static int rd_get_read_retry_count(struct ssd *ssd, struct ppa *ppa,
+                                   double *raw_rber)
+{
+    struct ssdparams *spp = &ssd->sp;
+    struct nand_block *blk = get_blk(ssd, ppa);
+    double ec, rc, rber;
+    int bits_count, retry = 0;
+
+    if (!spp->rd_enable) {
+        if (raw_rber) {
+            *raw_rber = 0.0;
+        }
+        return 0;
+    }
+
+    /* erase_cnt==0 is treated as the first programmed P/E state.  A floor
+     * of one avoids mathematically eliminating the disturbance term. */
+    ec = (double)(blk->erase_cnt > 0 ? blk->erase_cnt : 1);
+    rc = (double)blk->read_cnt;
+    rber = spp->rd_epsilon + spp->rd_alpha * pow(ec, spp->rd_k) +
+           spp->rd_gamma * pow(ec, spp->rd_p) * pow(rc, spp->rd_q);
+    if (rber > 1.0) {
+        rber = 1.0;
+    }
+    if (raw_rber) {
+        *raw_rber = rber;
+    }
+
+    bits_count = spp->secs_per_pg * spp->secsz * 8;
+    while ((double)bits_count * rber > spp->rd_ecc_strength && retry < 16) {
+        /* Initial abstraction: each retry halves effective RBER. */
+        rber /= 2.0;
+        retry++;
+    }
+    return retry;
+}
