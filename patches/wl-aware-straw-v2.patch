+static inline int rd_pg_to_wl(struct ssd *ssd, int pg)
+{
+    return pg / ssd->sp.rd_pages_per_wl;
+}
+
+static bool rd_wl_has_valid_page(struct ssd *ssd, struct ppa *ppa, int wl)
+{
+    struct ssdparams *spp = &ssd->sp;
+    int first = wl * spp->rd_pages_per_wl;
+    int last = first + spp->rd_pages_per_wl;
+
+    if (last > spp->pgs_per_blk) {
+        last = spp->pgs_per_blk;
+    }
+    for (int pg = first; pg < last; pg++) {
+        ppa->g.pg = pg;
+        if (get_pg(ssd, ppa)->status == PG_VALID) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static double rd_wl_erc(struct ssd *ssd, struct nand_block *blk, int wl)
+{
+    struct ssdparams *spp = &ssd->sp;
+    uint64_t self = blk->wl_read_cnt[wl];
+    uint64_t adj = 0;
+    if (wl > 0) {
+        adj += blk->wl_read_cnt[wl - 1];
+    }
+    if (wl + 1 < blk->n_wls) {
+        adj += blk->wl_read_cnt[wl + 1];
+    }
+
+    uint64_t nonadj = blk->read_cnt;
+    uint64_t excluded = self + adj;
+    if (nonadj > excluded) {
+        nonadj -= excluded;
+    } else {
+        nonadj = 0;
+    }
+
+    double alpha = (double)spp->rd_straw_alpha_x1000 / 1000.0;
+    return alpha * (double)adj + (double)nonadj;
+}
+
+static int rd_reclaim_one_wl(struct ssd *ssd, struct ppa *trigger_ppa,
+                             int wl, double erc)
+{
+    struct ssdparams *spp = &ssd->sp;
+    struct ppa old = *trigger_ppa;
+    int first = wl * spp->rd_pages_per_wl;
+    int last = first + spp->rd_pages_per_wl;
+    int moved = 0;
+
+    if (last > spp->pgs_per_blk) {
+        last = spp->pgs_per_blk;
+    }
+
+    for (int pg = first; pg < last; pg++) {
+        old.g.pg = pg;
+        if (get_pg(ssd, &old)->status != PG_VALID) {
+            continue;
+        }
+        gc_read_page(ssd, &old);
+        gc_write_page(ssd, &old);
+        mark_page_invalid(ssd, &old);
+        set_rmap_ent(ssd, INVALID_LPN, &old);
+        moved++;
+    }
+
+    if (moved > 0) {
+        spp->rd_straw_reclaim_pages += moved;
+        spp->rd_straw_reclaim_wls++;
+        if (spp->rd_debug) {
+            ftl_log("RD STRAW WL reclaim: blk=%d wl=%d erc=%.1f pages=%d total_pages=%" PRIu64 "\n",
+                    trigger_ppa->g.blk, wl, erc, moved,
+                    spp->rd_straw_reclaim_pages);
+            fflush(stdout);
+        }
+    }
+    return moved;
+}
+
+static int rd_try_straw_reclaim(struct ssd *ssd, struct ppa *trigger_ppa)
+{
+    struct ssdparams *spp = &ssd->sp;
+    struct nand_block *blk = get_blk(ssd, trigger_ppa);
+    struct line *line = get_line(ssd, trigger_ppa);
+    int reclaimed_wls = 0;
+    int moved_pages = 0;
+
+    if (!spp->rd_enable || spp->rd_reclaim_policy != 1 ||
+        spp->rd_straw_erc_max <= 0) {
+        return 0;
+    }
+
+    if (line == ssd->wp.curline) {
+        spp->rd_straw_deferred++;
+        return 0;
+    }
+
+    if (spp->rd_straw_check_interval > 1 &&
+        blk->read_cnt % (uint64_t)spp->rd_straw_check_interval != 0) {
+        return 0;
+    }
+
+    for (int wl = 0; wl < blk->n_wls; wl++) {
+        struct ppa probe = *trigger_ppa;
+        double erc;
+
+        if (!rd_wl_has_valid_page(ssd, &probe, wl)) {
+            continue;
+        }
+
+        erc = rd_wl_erc(ssd, blk, wl);
+        if (erc < (double)spp->rd_straw_erc_max) {
+            continue;
+        }
+
+        int moved = rd_reclaim_one_wl(ssd, trigger_ppa, wl, erc);
+        if (moved > 0) {
+            reclaimed_wls++;
+            moved_pages += moved;
+        }
+    }
+
+    if (reclaimed_wls > 0) {
+        spp->rd_straw_reclaim_events++;
+        if (spp->rd_debug) {
+            ftl_log("RD STRAW event: blk=%d reads=%" PRIu64
+                    " wls=%d pages=%d events=%" PRIu64 "\n",
+                    trigger_ppa->g.blk, blk->read_cnt, reclaimed_wls,
+                    moved_pages, spp->rd_straw_reclaim_events);
+            fflush(stdout);
+        }
+    }
+    return moved_pages;
+}
